# Briefly environment variables.
# Copy to .env.local and fill in. All are OPTIONAL for a local demo:
#   - Without ANTHROPIC_API_KEY the pipeline runs in deterministic mock mode.
#   - Without Supabase, matters are stored in memory (lost on restart).

# Anthropic API — enables the live Haiku-backed extraction pipeline.
ANTHROPIC_API_KEY=

# Optional: override the extraction model (defaults to claude-haiku-4-5).
# BRIEFLY_MODEL=claude-haiku-4-5

# Supabase — server-side, service-role only. NEVER expose the service key
# to the browser. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Inbound email (Phase 1). Shared secret gating POST /api/inbound. Set the same
# value in your mail provider's webhook URL (?token=...) or an auth header.
# Required for the endpoint to accept requests (fails closed if unset).
INBOUND_WEBHOOK_SECRET=

